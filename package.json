    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:ui": "playwright test",
    "export:web": "expo export --platform web",
    "preview": "node scripts/serve.mjs",
    "branding:render": "node scripts/render-icon.mjs",
    "sounds:download": "node scripts/download-sounds.mjs",
    "build:android": "npx eas-cli@latest build --platform android --profile preview",
    "build:android:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "build:ios": "npx eas-cli@latest build --platform ios --profile production"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "private": true
