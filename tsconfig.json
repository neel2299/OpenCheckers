{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "types": ["react", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "playwright.config.ts", "expo-env.d.ts", ".expo/types/**/*.ts"],
  "exclude": ["node_modules", "dist", ".cache", "artifacts", "draughts-club"]
}
